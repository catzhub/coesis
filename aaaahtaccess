RewriteEngine On

# EXCLUDE Google Identity requests
RewriteCond %{REQUEST_URI} ^/\.well-known/ [OR]
RewriteCond %{REQUEST_URI} ^/google-login\.php$ [OR]
RewriteCond %{REQUEST_URI} ^/logout\.php$
RewriteRule ^ - [L]

# Redirect .php → clean URL
RewriteCond %{THE_REQUEST} \s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Rewrite clean URL → .php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]